# ========================================
# API CONFIGURATION - DUAL BACKEND SETUP
# ========================================
# CRITICAL: This app uses TWO separate backend services:
# 1. Auth Service (Port 8080) - Authentication ONLY
# 2. Jendo Backend (Port 8090) - Business logic ONLY

# Auth Service (Port 8080)
# Handles: Login, Register, Token Refresh
EXPO_PUBLIC_AUTH_URL=http://192.168.130.49:8080/api/auth

# Jendo Backend (Port 8090)
# Handles: Business logic (consultations, reports, etc.)
# Requires JWT token in Authorization header
EXPO_PUBLIC_BACKEND_URL=http://192.168.130.49:8090/api

# Legacy variable (keeping for backward compatibility)
EXPO_PUBLIC_API_URL=http://192.168.130.49:8090/api

